# Copia este archivo a .env y ajusta los valores.

# Sin MONGODB_URI, en desarrollo se arranca un MongoDB local que guarda los datos en
# MONGO_DATA_DIR (por defecto ~/.clustr/mongo). Ejemplos de URI:
#   MONGODB_URI=mongodb://127.0.0.1:27017/clustr
#   MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<tu-cluster>/clustr
MONGODB_URI=

# Obligatorio en producción. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# MONGO_DATA_DIR=

PORT=3100
HOST=0.0.0.0
# Origen del frontend (varios separados por coma)
CORS_ORIGIN=http://localhost:5180

# Login con Google: ID de cliente OAuth (tipo "Aplicación web") de https://console.cloud.google.com/apis/credentials
# Debe ser el mismo que VITE_GOOGLE_CLIENT_ID en el front. Sin él, /auth/google responde 503.
GOOGLE_CLIENT_ID=
